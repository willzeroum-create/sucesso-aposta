{
  "name": "sucesso-aposta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate --silent && next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.mts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.mts",
    "test": "tsx --conditions=react-server --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.2",
    "docxtemplater": "^3.71.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.3.0",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
