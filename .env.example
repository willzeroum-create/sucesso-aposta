# Public landing preview. Copy to .env.local; never commit actual credentials.
# demo = illustrative inventory + simulated lead confirmation; remote = real API.
CATALOG_MODE=demo

# Server-side catalogue endpoint. Required only when CATALOG_MODE=remote.
# Expected payload: { site, vehicles, heroSlides }; see docs/BACKEND_HANDOFF.md.
CATALOG_API_URL=
CATALOG_API_TOKEN=

# Optional public image storage allowlist (comma-separated HTTPS URL patterns).
# Example syntax: https://cdn.example.com/stand-media/**
# Restart/rebuild after changing this value. Local /images paths work by default.
IMAGE_REMOTE_PATTERNS=

# RESERVED for Claude's private hero-generation worker (not implemented yet).
# Never use NEXT_PUBLIC_ prefixes for these secrets.
HERO_GENERATION_PROVIDER=openai
OPENAI_API_KEY=
HERO_GENERATION_MODEL=

# RESERVED: future database / private storage credentials belong on the server.
# Configure them when the backend's provider and storage are selected.
