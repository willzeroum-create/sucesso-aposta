# Copiar para .env.local (local) ou para as variáveis do alojamento. Nunca versionar credenciais.
# Nenhuma destas variáveis usa o prefixo NEXT_PUBLIC_: todas ficam no servidor.

# ── Catálogo público ─────────────────────────────────────────────
# demo     = exemplos ilustrativos + confirmação simulada do formulário (predefinido)
# database = viaturas e capas publicadas no painel deste projeto (produção recomendada)
# remote   = serviço HTTP externo (CATALOG_API_URL) com o contrato de docs/BACKEND_HANDOFF.md
CATALOG_MODE=demo
CATALOG_API_URL=
# Se definido, também protege GET /api/public/catalog deste projeto (Bearer).
CATALOG_API_TOKEN=

# Padrões HTTPS de imagens remotas (separados por vírgula). As fotos do painel são servidas em /media e não precisam disto.
IMAGE_REMOTE_PATTERNS=

# ── Base de dados ────────────────────────────────────────────────
# Vazio = ficheiro local ./data/app.db. Produção serverless: Turso/libSQL.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Ficheiros (fotografias e documentos) ─────────────────────────
# local (predefinido, ./data/uploads) ou blob (Vercel Blob privado; obrigatório na Vercel).
STORAGE_DRIVER=local
UPLOADS_DIR=
BLOB_READ_WRITE_TOKEN=

# Sal para pseudonimizar o IP dos pedidos de contacto (qualquer texto longo e aleatório).
SESSION_SECRET=

# Usada só por `npm.cmd run admin:create` se quiser fixar a palavra-passe inicial (senão é gerada).
ADMIN_INITIAL_PASSWORD=

# ── Leitura de documentos com IA (mesma camada do LegalCar) ──────
# Sem IA_PROVIDER: Gemini se houver GEMINI_API_KEY, senão Anthropic.
IA_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Pesquisa por VIN ─────────────────────────────────────────────
# NHTSA vPIC e RDW (Países Baixos) são gratuitos e não precisam de chave.
# Opcional, pago, ficha técnica europeia completa: https://vindecoder.eu
VINDECODER_EU_API_KEY=
VINDECODER_EU_SECRET=

# ── Anúncios (só leitura) ────────────────────────────────────────
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID da conta (10 algarismos, com ou sem hífenes) e, se acede através de uma conta de gestor (MCC), o ID dessa conta.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# ── Geração de fundos do hero (reservado, ainda sem integração) ──
HERO_GENERATION_PROVIDER=openai
OPENAI_API_KEY=
HERO_GENERATION_MODEL=
